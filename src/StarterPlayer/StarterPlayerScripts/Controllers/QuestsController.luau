local RS=game:GetService("ReplicatedStorage")
local TweenService=game:GetService("TweenService")
local ActivityConfig=require(RS.Config.ActivityConfig)
local Icons=require(RS.Config.IconsConfig)
local Q={}
local TABS={"Main","Activities","Completed"}
local COLORS={Panel=Color3.fromRGB(14,30,46),Hover=Color3.fromRGB(19,49,73),Selected=Color3.fromRGB(10,56,89),Stroke=Color3.fromRGB(16,65,104),Cyan=Color3.fromRGB(48,187,255),White=Color3.fromRGB(245,248,252),Text=Color3.fromRGB(198,216,234),Muted=Color3.fromRGB(122,154,184),Faint=Color3.fromRGB(74,104,132),Green=Color3.fromRGB(66,219,148),Gold=Color3.fromRGB(255,187,64)}
local function countMap(map)local n=0 for _ in pairs(map or {})do n+=1 end return n end
local function prettyKind(v)return tostring(v or"Activity"):gsub("(%l)(%u)","%1 %2")end
local function strokeOf(o)return o and o:FindFirstChildOfClass("UIStroke")end
local function setStroke(o,c,t)local s=strokeOf(o)if s then s.Color=c s.Transparency=t or s.Transparency end end
local function setText(root,name,text)local l=root and root:FindFirstChild(name)if l and l:IsA("TextLabel")then l.Text=tostring(text or"")end return l end
local function setImage(root,name,image)local o=root and root:FindFirstChild(name)if o and o:IsA("ImageLabel")then o.Image=image or""end return o end
local function setTabVisual(b,selected)b.BackgroundColor3=selected and COLORS.Selected or COLORS.Panel b.BackgroundTransparency=selected and .01 or .04 setStroke(b,selected and COLORS.Cyan or COLORS.Stroke,selected and .04 or .34)local l=b:FindFirstChild("Label")if l and l:IsA("TextLabel")then l.TextColor3=selected and COLORS.White or COLORS.Text end local i=b:FindFirstChild("Icon")if i and i:IsA("ImageLabel")then i.ImageColor3=selected and COLORS.Cyan or COLORS.Muted end end
local function bindTab(controller,b,name,state)if not b or not b:IsA("GuiButton")then return end local function selected()return state.Tab==name end setTabVisual(b,selected())b.MouseEnter:Connect(function()if not selected()then b.BackgroundColor3=COLORS.Hover end end)b.MouseLeave:Connect(function()setTabVisual(b,selected())end)b.Activated:Connect(function()if state.Tab~=name then state.Tab=name controller:RenderMenu()end end)end
local function setAction(b,text,state,callback)if not b or not b:IsA("TextButton")then return end b.Text=text or"" b.AutoButtonColor=false local enabled=callback~=nil b.Active=enabled b.Selectable=enabled b.TextTransparency=enabled and 0 or .28 local base,border=COLORS.Selected,COLORS.Cyan if state=="success"then base=Color3.fromRGB(12,94,62)border=COLORS.Green elseif state=="complete"then base=Color3.fromRGB(52,45,20)border=COLORS.Gold elseif state=="disabled"then base=Color3.fromRGB(25,39,53)border=COLORS.Faint end b.BackgroundColor3=base setStroke(b,border,enabled and .08 or .45)if enabled then b.MouseEnter:Connect(function()TweenService:Create(b,TweenInfo.new(.11),{BackgroundColor3=base:Lerp(Color3.new(1,1,1),.08)}):Play()end)b.MouseLeave:Connect(function()TweenService:Create(b,TweenInfo.new(.11),{BackgroundColor3=base}):Play()end)b.Activated:Connect(callback)end end
local function cardTemplate(runtime)local c=runtime:FindFirstChild("Components")local t=c and c:FindFirstChild("QuestCardTemplate")if not t or not t:IsA("Frame")then error("[QuestsV2] Authored QuestCardTemplate missing")end return t end
local function addCard(runtime,list,order,d)local card=cardTemplate(runtime):Clone()card.Name="QuestCard_"..tostring(d.Id or order)card.Visible=true card.LayoutOrder=order card.Parent=list local box=card:FindFirstChild("IconBox")if box then setImage(box,"Icon",d.Icon)end setText(card,"Title",d.Title)setText(card,"Description",d.Description)setText(card,"ProgressText",d.ProgressText)setText(card,"Meta",d.Meta)local pill=setText(card,"StatePill",d.StateText or"")if pill then pill.TextColor3=d.StateColor or COLORS.Cyan end local track=card:FindFirstChild("ProgressTrack")local fill=track and track:FindFirstChild("Fill")if fill and fill:IsA("Frame")then fill.Size=UDim2.fromScale(math.clamp(tonumber(d.Progress)or 0,0,1),1)fill.BackgroundColor3=d.ProgressColor or COLORS.Cyan end local reward=card:FindFirstChild("RewardBox")if reward then setText(reward,"RewardLabel",d.RewardLabel or"REWARD")setText(reward,"RewardText",d.RewardText or"Progression")setImage(reward,"RewardIcon",d.RewardIcon or Icons.Get("System","Quests"))end setAction(card:FindFirstChild("ActionButton"),d.ActionText,d.ActionState,d.Action)setStroke(card,d.CardStroke or COLORS.Stroke,d.CardStrokeTransparency or .22)return card end
local function addEmpty(runtime,list,title,description)local c=runtime:FindFirstChild("Components")local t=c and c:FindFirstChild("EmptyStateTemplate")if not t or not t:IsA("Frame")then return end local e=t:Clone()e.Name="EmptyState"e.Visible=true e.LayoutOrder=1 setText(e,"Title",title)setText(e,"Description",description)e.Parent=list end
local function rewardIcon(r)r=r or{}if(r.AncientNectar or 0)>0 then return Icons.GetCurrencyIcon("AncientNectar")end if(r.WorkshopPoints or 0)>0 then return Icons.Get("Menus","Workshop")end if(r.PetalDust or 0)>0 then return Icons.GetCurrencyIcon("PetalDust")end if(r.Coins or 0)>0 then return Icons.GetCurrencyIcon("Coins")end return Icons.Get("System","Quests")end
local function addQuestCard(controller,runtime,list,order,item)local actionText,state,action if item.Claimed then actionText="CLAIMED"state="complete"elseif item.Claimable then actionText="CLAIM"state="success"action=function()controller:Send("ClaimQuest",item.Id)end elseif item.Unlocked then actionText="IN PROGRESS"state="disabled"else actionText="LOCKED"state="disabled"end addCard(runtime,list,order,{Id=item.Id,Title=item.Title,Description=item.Description,Icon=Icons.Get("System","Quests"),Progress=item.Progress,ProgressText=tostring(item.Current or 0).." / "..tostring(item.Target or 1),ProgressColor=item.Claimed and COLORS.Gold or item.Claimable and COLORS.Green or COLORS.Cyan,Meta="QUEST "..tostring(item.Order or order).." / 25",RewardLabel="REWARD",RewardText=item.RewardText,RewardIcon=rewardIcon(item.Reward),StateText=item.Claimed and"COMPLETE"or item.Claimable and"READY"or item.Unlocked and"ACTIVE"or"LOCKED",StateColor=item.Claimed and COLORS.Gold or item.Claimable and COLORS.Green or item.Unlocked and COLORS.Cyan or COLORS.Faint,ActionText=actionText,ActionState=state,Action=action,CardStroke=item.Claimable and COLORS.Green or item.Claimed and COLORS.Gold or COLORS.Stroke,CardStrokeTransparency=item.Claimable and .06 or .22})end
local function activityReward(kind)local cfg=ActivityConfig.Types[kind]or{}if cfg.Boost and cfg.Boost.Label then return tostring(cfg.Boost.Label)end local charge=tonumber(cfg.Charge)or 0 return charge>0 and("+"..tostring(charge).." Bloom")or"World activity"end
local function sortedActivities(controller)local out={}for id,item in pairs(controller.Activities and controller.Activities.Items or{})do out[#out+1]={Id=id,Item=item}end table.sort(out,function(a,b)local ae=tonumber(a.Item.Expires)or math.huge local be=tonumber(b.Item.Expires)or math.huge return ae==be and tostring(a.Id)<tostring(b.Id)or ae<be end)return out end
local function addActivityCard(controller,runtime,list,order,id,item)local index=math.max(1,tonumber(item.Index)or 1)local count=math.max(1,tonumber(item.Count)or 1)local completed=math.clamp(index-1,0,count)local seconds=math.max(0,math.ceil((tonumber(item.Expires)or workspace:GetServerTimeNow())-workspace:GetServerTimeNow()))local tracked=controller.Activities and controller.Activities.TrackedId==id addCard(runtime,list,order,{Id="Activity_"..tostring(id),Title=prettyKind(item.Kind),Description="Reach the highlighted world checkpoints before the activity expires.",Icon=Icons.Get("System","Garden"),Progress=completed/count,ProgressText=tostring(completed).." / "..tostring(count),ProgressColor=tracked and COLORS.Green or COLORS.Cyan,Meta=tostring(seconds).."s left",RewardLabel="ACTIVITY",RewardText=activityReward(item.Kind),RewardIcon=Icons.Get("System","Flower"),StateText=tracked and"TRACKED"or"WORLD",StateColor=tracked and COLORS.Green or COLORS.Cyan,ActionText=tracked and"TRACKED"or"TRACK",ActionState=tracked and"success"or"primary",Action=function()if controller.Activities and controller.Activities.SetTracked then controller.Activities:SetTracked(id)end controller:RenderMenu()end,CardStroke=tracked and COLORS.Green or COLORS.Stroke,CardStrokeTransparency=tracked and .08 or .22})end
local function updateSummary(controller,runtime,uiState)local summary=runtime:FindFirstChild("SummaryBar",true)if not summary then return end local quests=uiState.Quests or{}local journey=summary:FindFirstChild("SummaryJourney")local completed=summary:FindFirstChild("SummaryQuests")local activities=summary:FindFirstChild("SummaryActivities")if journey then local step=math.min(tonumber(quests.CurrentStep)or 1,tonumber(quests.Total)or controller:JourneyCount())setText(journey,"Label","Current quest")setText(journey,"Value",tostring(step).." / "..tostring(quests.Total or controller:JourneyCount()))end if completed then setText(completed,"Value",tostring(quests.Completed or 0).." / "..tostring(quests.Total or 25))end if activities then setText(activities,"Value",tostring(countMap(controller.Activities and controller.Activities.Items)))end end
function Q.Render(controller,profile,uiState)local prototype=controller.Panel:FindFirstChild("QuestsPrototype")if not prototype or not prototype:IsA("Frame")then controller:Label(controller.Content,"QuestsPrototype missing",32)return end controller.QuestsV2State=controller.QuestsV2State or{Tab="Main"}local state=controller.QuestsV2State if not table.find(TABS,state.Tab)then state.Tab="Main"end local runtime=prototype:Clone()runtime.Name="QuestsV2Runtime"runtime.Visible=true runtime.Position=UDim2.fromScale(0,0)runtime.Size=UDim2.fromScale(1,1)runtime.LayoutOrder=1 runtime.Parent=controller.Content local shell=runtime:FindFirstChild("QuestsShell")local sidebar=shell and shell:FindFirstChild("Sidebar")local list=shell and shell:FindFirstChild("QuestList")if not shell or not sidebar or not list or not list:IsA("ScrollingFrame")then error("[QuestsV2] Authored QuestsPrototype structure is incomplete")end for _,tab in ipairs(TABS)do bindTab(controller,sidebar:FindFirstChild("Tab_"..tab),tab,state)end updateSummary(controller,runtime,uiState)for _,child in ipairs(list:GetChildren())do if child:IsA("GuiObject")then child:Destroy()end end list.CanvasPosition=Vector2.new()local questState=uiState.Quests or{Items={}}if state.Tab=="Main"then local order=0 for _,item in ipairs(questState.Items or{})do if not item.Claimed then order+=1 addQuestCard(controller,runtime,list,order,item)end end if order==0 then addEmpty(runtime,list,"All 25 quests complete","You finished the current Bloom RNG quest line.")end elseif state.Tab=="Activities"then local activities=sortedActivities(controller)if#activities==0 then addEmpty(runtime,list,"No active activities","World activities appear here while they are active.")else for i,entry in ipairs(activities)do addActivityCard(controller,runtime,list,i,entry.Id,entry.Item)end end elseif state.Tab=="Completed"then local order=0 for _,item in ipairs(questState.Items or{})do if item.Claimed then order+=1 addQuestCard(controller,runtime,list,order,item)end end if order==0 then addEmpty(runtime,list,"No completed quests","Claimed quests will appear here.")end end end
return Q
